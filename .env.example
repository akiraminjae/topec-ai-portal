# TOPEC AI 포털 — 환경변수 템플릿
# 이 파일을 backend/gateway/.env 로 복사한 뒤 실제 값을 채워 넣으세요.
# .env 는 .gitignore에 포함되어 있어 git에 커밋되지 않습니다.

# ── LLM 하이브리드 전략 ──────────────────────────────────────
# 외부 API 공급자: anthropic | openai | gemini
LLM_PROVIDER=anthropic
EXTERNAL_MODEL=claude-sonnet-5

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# 사내 서빙(폐쇄망) — 실제 TOPEC GPU 서버에 vLLM/Ollama 등을 구축한 뒤 주소 교체
INTERNAL_LLM_ENDPOINT=http://internal-llm:11434
INTERNAL_LLM_MODEL=llama3.1

# ── 게이트웨이 ───────────────────────────────────────────────
PORT=8100

# ── 프론트엔드 ───────────────────────────────────────────────
GATEWAY_URL=http://localhost:8100

# ── 데이터베이스 (governance_service, auth_service 전용) ──────
# docker-compose로 실행하면 자동으로 postgres 컨테이너를 가리키도록 설정되어 있습니다.
# 개별 서비스를 로컬에서 직접 실행할 때만 필요하며, 비워두면 SQLite 파일로 자동 폴백합니다.
# 예: postgresql://topec:change-me-in-prod@localhost:5432/topec_portal
DATABASE_URL=
